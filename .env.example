# --- Postgres ---------------------------------------------------------------
POSTGRES_PORT=5544
POSTGRES_PASSWORD=postgres
APP_USER_PASSWORD=app_user
APP_WORKER_PASSWORD=app_worker
# Migrations (dbmate) rodam como superusuário/dono das tabelas
DATABASE_URL_OWNER=postgresql://postgres:postgres@localhost:5544/saude_financeira?sslmode=disable
# API conecta como app_user (sujeito a RLS)
DATABASE_URL=postgresql://app_user:app_user@localhost:5544/saude_financeira
# Worker usa app_worker (BYPASSRLS) só para varreduras entre tenants
# Banco separado para os testes automatizados
DATABASE_URL_TEST_OWNER=postgresql://postgres:postgres@localhost:5544/saude_financeira_test?sslmode=disable
DATABASE_URL_TEST=postgresql://app_user:app_user@localhost:5544/saude_financeira_test
WORKER_DATABASE_URL=postgresql://app_worker:app_worker@localhost:5544/saude_financeira

# --- API / Web --------------------------------------------------------------
API_PORT=4100
PUBLIC_API_URL=http://localhost:4100
PUBLIC_WEB_URL=http://localhost:5173
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TZ_DEFAULT=America/Sao_Paulo
# Atrás de proxy reverso: "loopback", "uniquelocal" ou true. Vazio = não confia em X-Forwarded-For
TRUST_PROXY=

# --- Arquivos locais --------------------------------------------------------
FILES_DIR=./data/files
# 32 bytes em base64: openssl rand -base64 32
FILES_ENCRYPTION_KEY=
FILES_URL_SECRET=troque-por-outra-string-aleatoria

# --- E-mail (Mailpit em dev) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM="Saúde Financeira <nao-responda@localhost>"

# --- LLM --------------------------------------------------------------------
# anthropic | fake (fake = modo demonstração por regras, sem chave)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-opus-5-5

# --- WhatsApp (Evolution API) ----------------------------------------------
EVOLUTION_PORT=8085
EVOLUTION_URL=http://localhost:8085
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_INSTANCE=saude-financeira
EVOLUTION_WEBHOOK_SECRET=troque-este-segredo
# URL que o container da Evolution usa para chamar a API
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:4100

# --- Dados de mercado -------------------------------------------------------
BRAPI_TOKEN=
