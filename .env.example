# --- Postgres ---------------------------------------------------------------
POSTGRES_PORT=5544
POSTGRES_PASSWORD=postgres
APP_USER_PASSWORD=app_user
APP_WORKER_PASSWORD=app_worker
# Migrations (dbmate) rodam como superusuário/dono das tabelas
DATABASE_URL_OWNER=postgresql://postgres:postgres@localhost:5544/saude_financeira?sslmode=disable
# API conecta como app_user (sujeito a RLS)
DATABASE_URL=postgresql://app_user:app_user@localhost:5544/saude_financeira
# Worker usa app_worker (BYPASSRLS) só para varreduras entre tenants
# Banco separado para os testes automatizados
DATABASE_URL_TEST_OWNER=postgresql://postgres:postgres@localhost:5544/saude_financeira_test?sslmode=disable
DATABASE_URL_TEST=postgresql://app_user:app_user@localhost:5544/saude_financeira_test
WORKER_DATABASE_URL=postgresql://app_worker:app_worker@localhost:5544/saude_financeira

# --- API / Web --------------------------------------------------------------
API_PORT=4100
PUBLIC_API_URL=http://localhost:4100
PUBLIC_WEB_URL=http://localhost:5173
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TZ_DEFAULT=America/Sao_Paulo
# Atrás de proxy reverso: "loopback", "uniquelocal" ou true. Vazio = não confia em X-Forwarded-For
TRUST_PROXY=

# --- Arquivos locais --------------------------------------------------------
FILES_DIR=./data/files
# 32 bytes em base64: openssl rand -base64 32
FILES_ENCRYPTION_KEY=
FILES_URL_SECRET=troque-por-outra-string-aleatoria

# --- E-mail (Mailpit em dev) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1026
# Produção: credenciais do provedor (Resend, Brevo, SES...). SMTP_SECURE=true só na porta 465.
# SMTP_HOST vazio = e-mails só vão para o log.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM="Saúde Financeira <nao-responda@localhost>"

# --- Administração -----------------------------------------------------------
# E-mails (separados por vírgula) que podem editar as chaves e modelos de IA em
# Configurações → Inteligência artificial. O que for salvo lá substitui as variáveis de LLM,
# transcrição e voz abaixo (elas viram fallback) e vale sem reiniciar.
ADMIN_EMAILS=

# --- LLM --------------------------------------------------------------------
# anthropic | fake (fake = modo demonstração por regras, sem chave)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-opus-5-5

# --- Transcrição de áudio (opcional) ---------------------------------------
# Endpoint compatível com OpenAI (/audio/transcriptions). Sem chave e sem URL, o app segue sem áudio.
#   OpenAI:  TRANSCRIBE_API_KEY=sk-...   (modelo whisper-1 ou gpt-4o-mini-transcribe, mais barato)
#   Groq:    TRANSCRIBE_URL=https://api.groq.com/openai/v1  TRANSCRIBE_MODEL=whisper-large-v3-turbo
#   Próprio: TRANSCRIBE_URL=http://localhost:8000/v1 (faster-whisper-server / speaches), sem chave
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_USD_PER_MIN=0.006

# --- Conversa por voz em tempo real (opcional, OpenAI Realtime) ------------
# O navegador fala direto com a OpenAI por WebRTC usando um segredo efêmero criado pela API.
# Sem REALTIME_API_KEY, reaproveita TRANSCRIBE_API_KEY quando a transcrição é da OpenAI.
REALTIME_API_KEY=
# só para VOICE_PROVIDER=realtime (o modelo do modo live é LIVE_MODEL)
REALTIME_MODEL=gpt-realtime
# vozes: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
REALTIME_VOICE=marin
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
REALTIME_USD_PER_MIN=0.15
REALTIME_MAX_MINUTES=10
# Motor da voz (troque e reinicie a API para comparar):
#   realtime = gpt-realtime: conversa por turnos e chama as ferramentas direto (REALTIME_MODEL/VOICE)
#   live     = gpt-live-1: full duplex; cada pedido é delegado ao orquestrador do chat (Claude),
#              com as mesmas prévias e filtros. Voz cobrada à parte do raciocínio.
VOICE_PROVIDER=realtime
LIVE_MODEL=gpt-live-1
# vazio = voz padrão; opções: quartz, ripple, vesper, willow, stone, gleam, meridian, bossa, tempo,
# beacon, delta, cinder, nuri, juni, flitz, brise, sillage, nira, harema, shida, noeul
LIVE_VOICE=
LIVE_USD_PER_MIN=0.05

# --- WhatsApp (Evolution API) ----------------------------------------------
EVOLUTION_PORT=8085
EVOLUTION_URL=http://localhost:8085
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_INSTANCE=saude-financeira
EVOLUTION_WEBHOOK_SECRET=troque-este-segredo
# URL que o container da Evolution usa para chamar a API
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:4100

# --- Web Push (notificações no navegador/celular, opcional) ----------------
# Gere o par com: npx web-push generate-vapid-keys
# Vazias = push desligado (lembretes seguem por WhatsApp e e-mail).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@example.com

# --- Dados de mercado -------------------------------------------------------
BRAPI_TOKEN=
