# Variáveis para a aba "Environment" do Dokploy (serviço Compose com docker-compose.dokploy.yml).
# Senhas do banco: só letras e números (entram nas URLs de conexão).  openssl rand -hex 24

# --- Obrigatórias ------------------------------------------------------------
# URL pública do app (mesmo domínio configurado em Domains → serviço web, porta 80)
APP_URL=https://financas.seudominio.com
POSTGRES_PASSWORD=
# Só aplicadas na primeira criação do volume do banco
APP_USER_PASSWORD=
APP_WORKER_PASSWORD=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32  (guarde junto com o backup: sem ela os anexos não abrem)
FILES_ENCRYPTION_KEY=
# openssl rand -hex 32
FILES_URL_SECRET=

# --- LLM ---------------------------------------------------------------------
# Sem ANTHROPIC_API_KEY o agente roda em modo demonstração (regras)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-opus-5-5

# --- E-mail ------------------------------------------------------------------
# Vazio = e-mails só vão para o log. SMTP_SECURE=true só na porta 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM="Saúde Financeira <nao-responda@seudominio.com>"

# --- Opcionais ---------------------------------------------------------------
# Cotações de ações/FIIs/IBOV (brapi.dev)
BRAPI_TOKEN=
# Login com Google (callback: ${APP_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Transcrição de áudio (endpoint compatível com OpenAI). Sem chave e sem URL, fica desligada.
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_USD_PER_MIN=0.006
LOG_LEVEL=info

# --- WhatsApp (Evolution API) ------------------------------------------------
# Para ligar: descomente COMPOSE_PROFILES e preencha as demais.
# Deixe EVOLUTION_API_KEY vazia se não for usar: com ela preenchida a API tenta enviar pela Evolution.
# COMPOSE_PROFILES=whatsapp
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_INSTANCE=saude-financeira
# URL pública do painel da Evolution, se criar um domínio para ela (serviço evolution, porta 8080)
EVOLUTION_PUBLIC_URL=
