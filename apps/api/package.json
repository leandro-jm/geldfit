{
  "name": "@sf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean --no-splitting --noExternal @sf/shared --noExternal @sf/db --noExternal @sf/llm",
    "typecheck": "tsc -p tsconfig.json",
    "eval:cvm": "tsx --env-file=../../.env scripts/eval-cvm.ts",
    "whatsapp:setup": "tsx --env-file=../../.env scripts/whatsapp-setup.ts",
    "seed:demo": "tsx --env-file=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@sf/db": "workspace:*",
    "@sf/llm": "workspace:*",
    "@sf/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rrule": "^2.8.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
