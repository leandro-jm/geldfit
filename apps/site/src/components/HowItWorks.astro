---
import { Image } from 'astro:assets';
import foto from '../assets/photos/mulher-celular-sofa.jpg';
import { steps } from '../data/content';
---

<section id="como-funciona" class="py-20 sm:py-28" aria-labelledby="como-title">
  <div class="container-page grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary" data-reveal>Como funciona</p>
      <h2 id="como-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl sm:leading-[1.08]" data-reveal style="--d:1">
        Três passos. Nenhuma planilha.
      </h2>
      <ol class="relative mt-10 space-y-8 before:absolute before:bottom-4 before:left-5 before:top-4 before:w-px before:bg-border">
        {
          steps.map((s, i) => (
            <li class="relative flex gap-5" data-reveal style={`--d:${i + 2}`}>
              <span class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full bg-primary text-base font-bold text-primary-foreground shadow-[0_0_0_6px_var(--background)]">
                {s.n}
              </span>
              <div>
                <h3 class="text-xl font-semibold tracking-tight">{s.title}</h3>
                <p class="mt-1.5 leading-relaxed text-muted-foreground">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="relative" data-reveal="right">
      <div class="overflow-hidden rounded-[var(--radius-3xl)] shadow-[var(--shadow-pop)]">
        <Image
          src={foto}
          alt="Mulher sentada no sofá de casa conferindo as finanças pelo celular"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 540px, 92vw"
          class="aspect-[4/5] h-auto w-full object-cover object-[60%_center] sm:aspect-[4/3] lg:aspect-[4/5]"
        />
      </div>
      <div class="card float absolute -left-2 bottom-8 max-w-[270px] p-4 sm:-left-8">
        <p class="text-xs font-medium text-muted-foreground">WhatsApp · agora</p>
        <p class="mt-1.5 rounded-2xl rounded-tl-sm bg-muted px-3 py-2 text-sm">
          Conta de luz vence amanhã: R$ 230,00. Já pagou?
        </p>
        <p class="ml-auto mt-2 w-fit rounded-2xl rounded-tr-sm bg-primary px-3 py-2 text-sm text-primary-foreground">sim</p>
        <p class="mt-2 text-xs text-positive">✓ Pagamento registrado</p>
      </div>
    </div>
  </div>
</section>
