---
import { basics } from '../data/content';
import Icon from './Icon.astro';
---

<section class="py-20 sm:py-24" aria-labelledby="basico-title">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-muted-foreground" data-reveal>E também</p>
        <h2 id="basico-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-4xl" data-reveal style="--d:1">O básico, bem feito</h2>
      </div>
      <p class="max-w-md text-muted-foreground" data-reveal style="--d:2">
        O que você espera de qualquer app de finanças está aqui, sem custo extra.
      </p>
    </div>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        basics.map((b, i) => (
          <li class="flex gap-4 rounded-2xl border border-border bg-card/70 p-5" data-reveal style={`--d:${i % 4}`}>
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-muted text-muted-foreground">
              <Icon name={b.icon} size={19} />
            </span>
            <div>
              <h3 class="font-semibold leading-snug">{b.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{b.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
