---
import { Image } from 'astro:assets';
import casal from '../assets/photos/casal-contas-cozinha.jpg';
import { stats, statsSource } from '../data/content';
---

<section class="py-20 sm:py-28" aria-labelledby="problema-title">
  <div class="container-page grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div class="relative order-2 lg:order-1" data-reveal="left">
      <div class="overflow-hidden rounded-[var(--radius-3xl)] shadow-[var(--shadow-pop)]">
        <Image
          src={casal}
          alt="Casal na cozinha preocupado ao ler as contas do mês"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 540px, 92vw"
          class="aspect-[4/3] h-auto w-full object-cover"
        />
      </div>
      <div class="card absolute -bottom-6 right-4 max-w-[260px] p-4 sm:right-8">
        <p class="text-sm text-muted-foreground">A fatura chegou maior que o previsto?</p>
        <p class="mt-1 font-semibold">Com a projeção, você vê isso meses antes.</p>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary" data-reveal>O problema</p>
      <h2 id="problema-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-[2.6rem] sm:leading-[1.1]" data-reveal style="--d:1">
        Apps de gastos olham para trás. As parcelas estão na frente.
      </h2>
      <p class="mt-4 text-lg text-muted-foreground text-pretty" data-reveal style="--d:2">
        Saber quanto você gastou no mês passado não evita o aperto de março. O que pesa é o que já está
        contratado: parcelas no cartão, carnês, IPVA, matrícula.
      </p>
      <dl class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          stats.map((s, i) => (
            <div class="card p-5" data-reveal style={`--d:${i + 2}`} data-count={s.value}>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-4xl font-extrabold tracking-tight text-primary tabular-nums">
                  <span data-count-value>{s.value}</span>{s.suffix}
                </span>
                <span class="mt-2 block text-sm leading-snug text-muted-foreground">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-xs text-muted-foreground">{statsSource}</p>
    </div>
  </div>
</section>
