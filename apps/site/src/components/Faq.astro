---
import { faq } from '../data/content';
import Icon from './Icon.astro';
---

<section id="perguntas" class="py-20 sm:py-28" aria-labelledby="faq-title">
  <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary" data-reveal>Perguntas frequentes</p>
      <h2 id="faq-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl sm:leading-[1.08]" data-reveal style="--d:1">
        Antes de você perguntar
      </h2>
    </div>
    <div class="divide-y divide-border border-y border-border">
      {
        faq.map((f, i) => (
          <details class="group py-2" data-reveal style={`--d:${i % 3}`} open={i === 0}>
            <summary class="flex min-h-14 items-center justify-between gap-4 rounded-lg py-3 text-lg font-semibold">
              <h3>{f.q}</h3>
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-border transition-transform duration-300 group-open:rotate-180">
                <Icon name="chevron" size={16} />
              </span>
            </summary>
            <p class="pb-4 pr-12 leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
