---
import { Image } from 'astro:assets';
import familia from '../assets/photos/familia-sofa.jpg';
import homem from '../assets/photos/homem-celular-sofa.jpg';
import jovem from '../assets/photos/jovem-celular-sorrindo.jpg';
import { personas } from '../data/content';

const photos = { jovem, familia, homem } as const;
---

<section class="py-20 sm:py-28" aria-labelledby="para-quem-title">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary" data-reveal>Para quem é</p>
      <h2 id="para-quem-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl sm:leading-[1.08]" data-reveal style="--d:1">
        Feito para a vida financeira real
      </h2>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        personas.map((p, i) => (
          <li class="card card-lift group overflow-hidden" data-reveal style={`--d:${i}`}>
            <div class="overflow-hidden">
              <Image
                src={photos[p.photo as keyof typeof photos]}
                alt={p.alt}
                widths={[400, 640, 800]}
                sizes="(min-width: 768px) 380px, 92vw"
                class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold tracking-tight">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
