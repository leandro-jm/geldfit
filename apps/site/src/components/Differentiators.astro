---
import { Image } from 'astro:assets';
import idosos from '../assets/photos/casal-idoso-contas.jpg';
import asDark from '../assets/screens/assistente-dark.png';
import asLight from '../assets/screens/assistente-light.png';
import calDark from '../assets/screens/calendario-dark.png';
import calLight from '../assets/screens/calendario-light.png';
import chartDark from '../assets/screens/projecao-grafico-dark.png';
import chartLight from '../assets/screens/projecao-grafico-light.png';
import { differentiators as d, type Feature } from '../data/content';
import Icon from './Icon.astro';
import ThemedShot from './ThemedShot.astro';

const [proj, renda, previa, cal, assist, prev, familia, priv] = d as Required<Feature>[];

// Barras da renda comprometida (percentual por mês), só para ilustrar o gráfico do app
const bars = [
  { m: 'nov', v: 38 }, { m: 'dez', v: 36 }, { m: 'jan', v: 31 }, { m: 'fev', v: 24 }, { m: 'mar', v: 22 },
  { m: 'abr', v: 17 }, { m: 'mai', v: 14 }, { m: 'jun', v: 9 },
];
const tone = (v: number) => (v > 30 ? 'bg-negative' : v > 20 ? 'bg-warning' : 'bg-primary');
---

<section id="diferenciais" class="relative py-20 sm:py-28" aria-labelledby="dif-title">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary" data-reveal>O que só a gente faz</p>
      <h2 id="dif-title" class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl sm:leading-[1.08]" data-reveal style="--d:1">
        Lançar gasto pelo WhatsApp todo app faz. <span class="text-muted-foreground">Enxergar o futuro, não.</span>
      </h2>
      <p class="mt-5 text-lg text-muted-foreground text-pretty" data-reveal style="--d:2">
        Comparamos com mais de oito assistentes financeiros brasileiros. Estes recursos praticamente nenhum deles tem.
      </p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-6 lg:gap-5">
      <!-- Projeção -->
      <article class="card spot card-lift overflow-hidden lg:col-span-4" data-reveal>
        <div class="grid h-full sm:grid-cols-[1fr_1.15fr]">
          <div class="flex flex-col p-6 sm:p-8">
            <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={proj.icon} /></span>
            <span class="mt-5 w-fit rounded-full bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground">{proj.tag}</span>
            <h3 class="mt-3 text-2xl font-bold tracking-tight">{proj.title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{proj.text}</p>
          </div>
          <div class="flex items-center border-t border-border bg-subtle p-4 sm:border-l sm:border-t-0 sm:p-6">
            <div class="w-full overflow-hidden rounded-2xl border border-border shadow-[var(--shadow-pop)]">
              <ThemedShot
                light={chartLight}
                dark={chartDark}
                alt="Gráfico de saldo projetado para 24 meses com faixa otimista e pessimista e linha de piso"
                widths={[480, 720, 1040, 1560]}
                sizes="(min-width: 1024px) 440px, (min-width: 640px) 50vw, 90vw"
              />
            </div>
          </div>
        </div>
      </article>

      <!-- Renda comprometida -->
      <article class="card spot card-lift flex flex-col p-6 sm:p-8 lg:col-span-2" data-reveal style="--d:1">
        <span class="grid size-11 place-items-center rounded-2xl bg-warning-soft text-warning"><Icon name={renda.icon} /></span>
        <span class="mt-5 w-fit rounded-full bg-warning-soft px-2.5 py-0.5 text-xs font-semibold text-warning">{renda.tag}</span>
        <h3 class="mt-3 text-2xl font-bold tracking-tight">{renda.title}</h3>
        <div class="mt-4" data-count="38">
          <p class="text-5xl font-extrabold tracking-tight tabular-nums"><span data-count-value>38</span>%</p>
          <p class="text-sm text-muted-foreground">da renda de março já está comprometida</p>
        </div>
        <div class="mt-6" data-bars aria-hidden="true">
          <div class="relative flex h-28 items-end gap-2">
            <div class="absolute inset-x-0 border-t border-dashed border-muted-foreground/50" style="bottom: 75%">
              <span class="absolute -top-4 right-0 text-[10px] text-muted-foreground">30%</span>
            </div>
            {bars.map((b, i) => <div class={`bar-grow flex-1 rounded-t-md ${tone(b.v)}`} style={`height:${b.v * 2.5}%; --d:${i}`} />)}
          </div>
          <div class="mt-1 flex gap-2">
            {bars.map((b) => <span class="flex-1 text-center text-[10px] text-muted-foreground">{b.m}</span>)}
          </div>
        </div>
        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{renda.text}</p>
      </article>

      <!-- Prévia e confirmação -->
      <article class="card spot card-lift flex flex-col p-6 sm:p-8 lg:col-span-3" data-reveal>
        <div class="flex items-start justify-between gap-4">
          <span class="grid size-11 place-items-center rounded-2xl bg-positive-soft text-positive"><Icon name={previa.icon} /></span>
          <span class="rounded-full bg-positive-soft px-2.5 py-0.5 text-xs font-semibold text-positive">{previa.tag}</span>
        </div>
        <h3 class="mt-5 text-2xl font-bold tracking-tight">{previa.title}</h3>
        <p class="mt-3 leading-relaxed text-muted-foreground">{previa.text}</p>
        <div class="mt-6 rounded-2xl border border-border bg-background p-4 text-sm" aria-hidden="true">
          <div class="flex items-center justify-between gap-2">
            <p class="font-semibold">Fatura Nubank · outubro</p>
            <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-medium text-primary-soft-foreground">Aguardando confirmação</span>
          </div>
          <ul class="mt-3 space-y-2">
            <li class="flex items-center justify-between"><span>23 lançamentos</span><span class="font-semibold tabular-nums">R$ 3.384,54</span></li>
            <li class="flex items-center gap-2 text-positive"><Icon name="check" size={16} /> Soma confere com o total da fatura</li>
            <li class="flex items-center gap-2 text-warning"><Icon name="minus" size={16} /> 2 possíveis duplicados marcados</li>
            <li class="flex items-center gap-2 text-muted-foreground"><Icon name="chart" size={16} /> Saldo projetado de novembro: −R$ 3.384,54</li>
          </ul>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">1 Confirmar</span>
            <span class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium">2 Editar</span>
            <span class="rounded-lg px-3 py-1.5 text-xs font-medium text-muted-foreground">3 Cancelar</span>
          </div>
        </div>
      </article>

      <!-- Calendário -->
      <article class="card spot card-lift flex flex-col overflow-hidden lg:col-span-3" data-reveal style="--d:1">
        <div class="p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={cal.icon} /></span>
            <span class="rounded-full bg-primary-soft px-2.5 py-0.5 text-xs font-semibold text-primary-soft-foreground">{cal.tag}</span>
          </div>
          <h3 class="mt-5 text-2xl font-bold tracking-tight">{cal.title}</h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">{cal.text}</p>
        </div>
        <div class="mt-auto max-h-72 overflow-hidden border-t border-border px-6 pt-6 sm:px-8">
          <div class="overflow-hidden rounded-t-xl border border-b-0 border-border shadow-[var(--shadow-soft)]">
            <ThemedShot
              light={calLight}
              dark={calDark}
              alt="Calendário anual com 13º salário, IPTU e IPVA detectados do histórico aguardando confirmação"
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 520px, 90vw"
            />
          </div>
        </div>
      </article>

      <!-- Assistente proativo -->
      <article class="card spot card-lift flex flex-col overflow-hidden lg:col-span-3" data-reveal>
        <div class="p-6 sm:p-8">
          <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={assist.icon} /></span>
          <h3 class="mt-5 text-2xl font-bold tracking-tight">{assist.title}</h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">{assist.text}</p>
        </div>
        <div class="mt-auto max-h-64 overflow-hidden border-t border-border px-6 pt-6 sm:px-8">
          <div class="overflow-hidden rounded-t-xl border border-b-0 border-border shadow-[var(--shadow-soft)]">
            <ThemedShot
              light={asLight}
              dark={asDark}
              alt="Caixa do assistente com sugestões: dar destino para a sobra e escolher o tipo de renda"
              widths={[480, 808]}
              sizes="(min-width: 1024px) 520px, 90vw"
            />
          </div>
        </div>
      </article>

      <!-- Previdência -->
      <article class="card card-lift relative flex min-h-[420px] flex-col justify-end overflow-hidden lg:col-span-3" data-reveal style="--d:1">
        <Image
          src={idosos}
          alt="Casal de aposentados conferindo documentos e contas na sala de casa"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 560px, 92vw"
          class="absolute inset-0 size-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/0" aria-hidden="true"></div>
        <div class="relative p-6 text-white sm:p-8">
          <span class="grid size-11 place-items-center rounded-2xl bg-white/15 backdrop-blur"><Icon name={prev.icon} /></span>
          <h3 class="mt-5 text-2xl font-bold tracking-tight">{prev.title}</h3>
          <p class="mt-3 leading-relaxed text-white/85">{prev.text}</p>
        </div>
      </article>

      <!-- Família -->
      <article class="card spot card-lift flex flex-col p-6 sm:p-8 lg:col-span-3" data-reveal>
        <span class="grid size-11 place-items-center rounded-2xl bg-primary-soft text-primary"><Icon name={familia.icon} /></span>
        <h3 class="mt-5 text-2xl font-bold tracking-tight">{familia.title}</h3>
        <p class="mt-3 leading-relaxed text-muted-foreground">{familia.text}</p>
        <ul class="mt-6 grid gap-2 text-sm" aria-label="Papéis no espaço da família">
          <li class="flex items-center justify-between rounded-xl border border-border bg-background px-4 py-3">
            <span class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground">A</span>Ana</span>
            <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-medium text-primary-soft-foreground">Dona</span>
          </li>
          <li class="flex items-center justify-between rounded-xl border border-border bg-background px-4 py-3">
            <span class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-full bg-positive text-xs font-bold text-white">R</span>Rafael</span>
            <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium">Membro</span>
          </li>
          <li class="flex items-center justify-between rounded-xl border border-border bg-background px-4 py-3">
            <span class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-full bg-warning text-xs font-bold text-white">C</span>Contadora</span>
            <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium">Leitora</span>
          </li>
          <li class="flex items-center gap-2 px-1 pt-1 text-muted-foreground"><Icon name="lock" size={15} /> Conta “Reserva pessoal” visível só para a Ana</li>
        </ul>
      </article>

      <!-- Privacidade -->
      <article class="card spot card-lift flex flex-col p-6 sm:p-8 lg:col-span-3" data-reveal style="--d:1">
        <span class="grid size-11 place-items-center rounded-2xl bg-positive-soft text-positive"><Icon name={priv.icon} /></span>
        <h3 class="mt-5 text-2xl font-bold tracking-tight">{priv.title}</h3>
        <p class="mt-3 leading-relaxed text-muted-foreground">{priv.text}</p>
        <ul class="mt-6 flex flex-wrap gap-2 text-sm">
          {
            ['AES-256 nos anexos', 'Máscara de cartão e CPF', 'Exportar em JSON/CSV', 'Apagar tudo', 'Isolamento por linha no banco', 'Sem senha de banco'].map(
              (t) => (
                <li class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1.5">
                  <Icon name="check" size={14} class="text-positive" />
                  {t}
                </li>
              ),
            )
          }
        </ul>
      </article>
    </div>
  </div>
</section>
