---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página não encontrada · Saúde Financeira</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="grid min-h-dvh place-items-center p-6 text-center">
    <main>
      <a href="/"><Logo class="text-lg" /></a>
      <h1 class="mt-8 text-3xl font-bold tracking-tight">Página não encontrada</h1>
      <p class="mt-3 text-muted-foreground">O endereço pode ter mudado.</p>
      <a href="/" class="btn btn-primary mt-8">Voltar ao início</a>
    </main>
  </body>
</html>
